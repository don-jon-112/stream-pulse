# StreamPulse Environment Configuration
PORT=3000

# Twitch Developer Application Credentials
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# YouTube / Google OAuth 2.0 Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# Konfigurasi Pengiriman Email OTP StreamPulse (Opsional)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key_here
# SMTP_FROM="StreamPulse" <noreply@yourdomain.com>

# TikTok LIVE Connection (Zero-Config Direct Engine)
# Secara default TIDAK MEMERLUKAN API KEY atau konfigurasi apapun (Unlimited & Free).
# Opsional: Jika streamer memiliki stream khusus 18+ (Age-restricted room), sessionid dapat ditambahkan:
# TIKTOK_SESSION_ID=your_tiktok_sessionid_cookie_here
# Opsional: nilai cookie `tt-target-idc` dari browser (DevTools > Application > Cookies > tiktok.com),
# di samping sessionid. Dikirim bersama Session ID. Kosongkan jika tidak yakin.
# TIKTOK_TT_TARGET_IDC=your_tt_target_idc_cookie_here

# Antrean koneksi TikTok (berguna jika banyak user memakai satu server/IP):
# TIKTOK_MAX_CONCURRENT_STARTS = berapa koneksi TikTok BARU yang boleh diproses bersamaan (default 2).
# TIKTOK_START_SPACING_MS      = jeda minimum antar start koneksi baru, dalam milidetik (default 3000).
# Koneksi yang sudah tersambung TIDAK dibatasi angka ini.
# TIKTOK_MAX_CONCURRENT_STARTS=2
# TIKTOK_START_SPACING_MS=3000
# Masa tenggang (ms) sebelum koneksi TikTok diputus setelah semua pendengar pergi, mis. saat dock/halaman di-refresh.
# Jika dock kembali dalam masa ini, koneksi TikTok yang sama dipakai ulang (tidak putus-sambung ke TikTok). Default 60000.
# TIKTOK_IDLE_GRACE_MS=60000

# --- Keamanan ---
# Kunci enkripsi token (WAJIB isi di produksi; contoh: openssl rand -hex 32)
ENCRYPTION_SECRET=
# Password admin (tanpa ini akses admin dinonaktifkan)
ADMIN_PASSWORD=
# Origin tambahan yang boleh memakai API/socket (pisah koma). Same-origin & app native sudah otomatis.
# Isi * untuk mengizinkan semua origin (perilaku lama).
ALLOWED_ORIGINS=
# URL publik server (opsional, ikut dianggap origin sendiri)
PUBLIC_URL=
